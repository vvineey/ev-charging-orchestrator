# Local development only. Copy to .env and replace both password placeholders.
# Spring reads this file only with the local profile; Compose reads it at the root.
COMPOSE_PROJECT_NAME=evc-current-local

POSTGRES_PORT=15432
POSTGRES_DB=telemetry_current
POSTGRES_USER=local_admin
POSTGRES_PASSWORD=replace-with-a-random-admin-password
APP_DB_USER=telemetry_app
APP_DB_PASSWORD=replace-with-a-different-random-app-password
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?connectTimeout=5&socketTimeout=15&ApplicationName=telemetry-worker-local
SPRING_DATASOURCE_USERNAME=${APP_DB_USER}
SPRING_DATASOURCE_PASSWORD=${APP_DB_PASSWORD}

KAFKA_PORT=19092
# Stable local KRaft ID. Keep it unchanged while reusing the Kafka volume.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
SPRING_KAFKA_BOOTSTRAPSERVERS=127.0.0.1:${KAFKA_PORT}
TELEMETRY_KAFKA_TOPIC=charger.telemetry

MQTT_PORT=11883
MQTT_URL=tcp://127.0.0.1:${MQTT_PORT}
MQTT_TOPIC=charger/telemetry
MQTT_CLIENT_ID=mqtt-adapter-local

# Run scripts/create-local-telemetry-tls.py with Java 21 after creating .env.
TELEMETRY_HTTPS_PORT=18443
TELEMETRY_TLS_KEY_STORE=file:./secrets/telemetry-worker.p12
TELEMETRY_TLS_KEY_STORE_PASSWORD=generated-by-local-tls-script
TELEMETRY_TLS_TRUST_STORE=./secrets/telemetry-client-trust.p12
TELEMETRY_TLS_TRUST_STORE_PASSWORD=generated-by-local-tls-script

# OCPP Gateway is disabled without its local profile. Run create-local-ocpp-tls.py
# to generate the private key and a random per-charger Basic credential.
OCPP_WSS_PORT=19443
OCPP_WSS_KEY_STORE=file:./secrets/ocpp-gateway.p12
OCPP_WSS_KEY_STORE_PASSWORD=
OCPP_CHARGING_STATION_ID=CS-KEBA-OCPP2-00001
OCPP_STATION_ID=station-simulator-1
OCPP_ALLOWED_EVSE_IDS=1
OCPP_STATION_PASSWORD=

# Control-plane transaction Inbox shares the local PostgreSQL server, but owns
# only its transaction_* and recovered_transaction_session tables.
CONTROL_TRANSACTION_INGRESS_ENABLED=false
# Optional overrides: CONTROL_DB_URL, CONTROL_DB_USERNAME, CONTROL_DB_PASSWORD
